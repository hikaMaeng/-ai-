# 실습 환경 설정 — 이 파일을 .env 로 복사해 값을 고친다 (cp env.example .env)
#   docker compose 가 저장소 루트의 .env 를 자동으로 읽는다. .env 는 저장소에 올리지 않는다(.gitignore)
#   값을 바꾼 뒤에는 docker compose up -d 로 컨테이너를 다시 만들어야 적용된다

# Jupyter 컨테이너가 쓸 GPU 번호 (nvidia-smi -L 의 번호, 한 장이면 0)
#   강사 PC : 0 = RTX 3090 · 1 = RTX 4080 → LAB_GPU=1
LAB_GPU=0

# ComfyUI(5-2, profile comfy)가 쓸 GPU 번호. GPU 두 장이면 LAB_GPU 와 다른 번호를 주면 나눠 쓴다
COMFY_GPU=0

# 8-1 : 호스트(내 PC)에서 켠 LM Studio 서버 주소. 컨테이너 안의 localhost 는 컨테이너 자신이라 host.docker.internal 로 닿는다
#   LM Studio 기본 포트는 1234. 강사 PC 는 12345 → http://host.docker.internal:12345/v1
LMSTUDIO_URL=http://host.docker.internal:1234/v1

# 8-1 : 쓸 모델 이름(LM Studio 의 모델 식별자). 비우면 노트북 기본값 qwen3.5-4b-mtp
AGENT_MODEL=
# 8-1 : auto(notebooks/cache 에 저장된 응답이 있으면 재생 · 없으면 서버 호출) · live(항상 서버 호출) · replay(저장된 응답만, 서버 없이)
AGENT_MODE=auto
# 8-1 : 생각을 먼저 쓰는 모델이 답이 빈 채로 잘리면 4096 처럼 max_tokens 하한을 준다(0 = 하한 없음, 느려짐)
AGENT_MIN_TOKENS=0

# 포트(기본값과 다를 때만). 모두 127.0.0.1 에만 열린다
# JUPYTER_PORT=8888
# DB_PORT=5432
# PGADMIN_PORT=5050
# COMFY_PORT=8188
